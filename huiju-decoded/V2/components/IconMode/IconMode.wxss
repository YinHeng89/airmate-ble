.mode-wrapper {
    gap: 70rpx;
    padding: 32rpx 38rpx
}

.evently-wrapper,.mode-wrapper {
    background: var(--item-background-color);
    border-radius: var(--item-border-radius);
    box-shadow: var(--item-box-shadow);
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap
}

.evently-wrapper {
    -webkit-justify-content: space-evenly;
    justify-content: space-evenly;
    padding: 32rpx 0rpx
}

.mode-image-wrap {
    height: 100rpx;
    position: relative;
    width: 100rpx
}

.mode-image {
    height: 48rpx;
    left: 50%;
    top: 50%;
    -webkit-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%);
    width: 48rpx;
    z-index: 5
}

.mode-image,.mode-image-bg {
    border-radius: 9999px;
    position: absolute
}

.mode-image-bg {
    height: 100rpx;
    left: 0;
    top: 0;
    width: 100rpx;
    z-index: 4
}

.mode-text {
    color: #69696c;
    font-size: 24rpx;
    font-weight: 400;
    line-height: 34rpx;
    text-align: center
}

.mode-item-wrapper {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    gap: 14rpx
}

.z-h {
    z-index: 11
}

.no-operate {
    color: #fff;
    opacity: .4;
    pointer-events: none
}
