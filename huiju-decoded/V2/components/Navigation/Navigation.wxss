.nav-wrapper {
    left: 0;
    position: fixed;
    top: 0;
    transition: background .5s;
    width: 100%;
    z-index: 999
}

.nav {
    -webkit-align-items: center;
    align-items: center;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 0 32rpx;
    width: 100%
}

.title-text {
    font-size: 32rpx;
    font-weight: 500;
    height: 1.5em;
    line-height: 1.5em
}

.default-bg {
    background: #fff
}
