.mode-wrapper {
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    gap: 31rpx
}

.mode-item,.mode-wrapper {
    display: -webkit-flex;
    display: flex
}

.mode-item {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 9999px;
    box-sizing: border-box;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100rpx
}

.mode-text {
    font-size: 24rpx;
    font-weight: 400;
    line-height: 34rpx;
    max-width: 72rpx;
    text-align: center
}

.active {
    background: #5086fe
}

.inactive {
    background: #eee
}

.active-text {
    color: #fff
}

.inactive-text {
    color: #69696c
}

.mode-item-2 {
    -webkit-align-items: center;
    align-items: center;
    background-color: #f8f8f8;
    border-radius: 9999px;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100rpx
}

.mode-item-fan:active {
    background-color: #4186fa
}

.mode-text-2 {
    color: #69696c;
    font-size: 24rpx;
    font-weight: 400;
    line-height: 34rpx;
    max-width: 72rpx;
    text-align: center
}

.mode-text-2:active {
    color: #fff
}

.disabled {
    background: #f0f0f0;
    opacity: .5
}

.disabled-text {
    color: silver
}
