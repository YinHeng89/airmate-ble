.warmer-wrap {
    background: #f4f6f8;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    min-height: 100vh;
    padding: 0 32rpx 32rpx;
    position: relative;
    width: 100%
}

.warmer-head-wrap {
    width: 100%;
    z-index: 12
}

.bg-box {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 9999px;
    display: -webkit-flex;
    display: flex;
    height: 416rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 80rpx auto;
    width: 416rpx
}

.bg-box.active {
    background: radial-gradient(0 50% at 50% 50%,#fff 0,#ffc3a1 100%);
    box-shadow: 0rpx 0rpx 100rpx 50rpx rgba(255,195,161,.5)
}

.bg-box.off {
    background: radial-gradient(0 50% at 50% 50%,#fff 0,#e1e5e8 100%)
}

.bg-box-1 {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 9999px;
    display: -webkit-flex;
    display: flex;
    height: 312rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 312rpx
}

.bg-box-1.active {
    background: #fff7ec
}

.bg-box-1.off {
    background: #f4f6f8
}

.fire {
    height: 160rpx;
    width: 160rpx
}

.warmer-content {
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column;
    gap: 64rpx;
    width: 100%
}

.switch-wrapper,.warmer-content {
    display: -webkit-flex;
    display: flex
}

.switch-wrapper {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff;
    border-radius: 16rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 32rpx;
    z-index: 11
}

.switch-text {
    color: #282c37;
    font-size: 16px
}

.switch {
    height: 32px;
    width: 32px
}

.mode-wrapper,.slider-wrapper {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column
}

.counter-label,.mode-label,.slider-label {
    color: #282c37;
    font-size: 28rpx;
    font-weight: 400;
    line-height: 40rpx;
    margin-bottom: 24rpx
}

.mask-wrapper {
    background: #f8f9fa;
    height: 100%;
    left: 0;
    opacity: .4;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 10
}

.head-status-wrap {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.blank-el {
    width: 104rpx
}

.tem-wrap {
    display: -webkit-flex;
    display: flex;
    gap: 64rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin-bottom: 32rpx;
    padding-right: 24rpx
}

.text1 {
    color: rgba(0,0,0,.6)
}

.text1,.text2 {
    font-size: 28rpx
}

.text1,.text2,.text3 {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex
}

.text3 {
    font-size: 48rpx;
    font-weight: 800;
    position: relative
}

.text3::after {
    color: #666;
    content: "℃";
    display: inline;
    font-size: 24rpx;
    height: 24rpx;
    position: absolute;
    right: -24rpx;
    top: 0;
    width: 24rpx
}
