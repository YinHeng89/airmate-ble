    border-radius: 48rpx;
    bottom: 148rpx;
    font-size: 34rpx;
    font-weight: 500;
    position: absolute
}

.btn-con {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex
}
