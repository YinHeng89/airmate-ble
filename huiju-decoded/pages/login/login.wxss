    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100vh;
    -webkit-justify-content: center;
    justify-content: center;
    position: relative;
    width: 100%
}

.img-bg {
    -webkit-align-self: center;
    align-self: center;
    width: 100%
}

.phone-icon {
    margin-right: 16rpx
}

