.light-wrap {
    background: #f4f6f8;
    min-height: 100vh;
    width: 100%
}

.light-head-wrap {
    display: -webkit-flex;
    display: flex
}

.light-head,.light-head-wrap {
    -webkit-justify-content: center;
    justify-content: center
}

.light-head {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding-top: 80rpx
}

.light-img {
    height: 412rpx;
    width: 400rpx
}

.switch-text {
    color: #69696c;
    font-size: 26rpx;
    font-style: normal;
    font-weight: 400;
    line-height: 40rpx;
    text-align: right
}

.light-content {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    gap: 32rpx;
    margin-top: 80rpx;
    padding: 0 32rpx
}

.light-slider-text {
    color: #282c37;
    font-size: 28rpx;
    font-weight: 400;
    margin-bottom: 24rpx
}
