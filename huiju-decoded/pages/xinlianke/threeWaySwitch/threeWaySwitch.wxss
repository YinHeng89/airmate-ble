.wrap {
    background: linear-gradient(180deg,#9eacc7,#dae1ee);
    min-height: 100vh;
    position: relative
}

.head,.wrap {
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    width: 100%
}

.head {
    padding: 0 32rpx
}

.head-status-wrap {
    -webkit-align-items: center;
    align-items: center;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.content,.head-status-wrap {
    display: -webkit-flex;
    display: flex
}

.content {
    -webkit-flex: 1;
    flex: 1;
    -webkit-flex-direction: column;
    flex-direction: column
}

.tip {
    color: hsla(240,1%,42%,.6);
    font-size: 24rpx;
    margin-top: 24rpx;
    text-align: center
}

.c-c {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex: 1;
    flex: 1;
    -webkit-justify-content: center;
    justify-content: center
}

.panel {
    background: #fff;
    border: 2rpx solid #e6e6e6;
    border-radius: 40rpx;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,.06);
    overflow: hidden;
    width: 600rpx
}

.panel-top {
    border-bottom: 2rpx solid #eee;
    height: 96rpx
}

.panel-page {
    height: 460rpx
}

.panel-body,.panel-btn {
    display: -webkit-flex;
    display: flex
}

.panel-btn {
    -webkit-align-items: center;
    align-items: center;
    -webkit-flex: 1;
    flex: 1;
    -webkit-justify-content: center;
    justify-content: center;
    position: relative;
    transition: background .2s
}

.panel-btn + .panel-btn {
    border-left: 2rpx solid #eee
}

.btn-name {
    color: #333;
    font-size: 32rpx
}

.btn-dot {
    background: #d8d8d8;
    border-radius: 50%;
    bottom: 56rpx;
    height: 14rpx;
    left: 50%;
    position: absolute;
    -webkit-transform: translateX(-50%);
    transform: translateX(-50%);
    transition: all .2s;
    width: 14rpx
}

.panel-btn.on {
    background: rgba(56,130,255,.08)
}

.panel-btn.on .btn-name {
    color: #3882ff
}

.panel-btn.on .btn-dot {
    background: #3882ff;
    box-shadow: 0 0 12rpx 2rpx rgba(56,130,255,.6)
}

.footer {
    display: -webkit-flex;
    display: flex;
    gap: 48rpx;
    -webkit-justify-content: center;
    justify-content: center;
    padding: 40rpx 32rpx 80rpx
}

.all-btn {
    background: #3882ff;
    border-radius: 44rpx;
    color: #fff;
    -webkit-flex: 1;
    flex: 1;
    font-size: 30rpx;
    height: 88rpx;
    line-height: 88rpx;
    max-width: 280rpx;
    text-align: center
}

.all-btn-off {
    background: hsla(0,0%,100%,.6);
    color: #69696c
}

.picker-mask {
    background: rgba(0,0,0,.4);
    height: 100%;
    -webkit-justify-content: flex-end;
    justify-content: flex-end;
    left: 0;
    position: fixed;
    top: 0;
    z-index: 100
}

.picker-mask,.picker-panel {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    width: 100%
}

.picker-panel {
    background: #fff;
    border-radius: 24rpx 24rpx 0 0;
    max-height: 70vh;
    overflow: hidden
}

.picker-head {
    -webkit-align-items: center;
    align-items: center;
    border-bottom: 1rpx solid #f0f0f0;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 28rpx 32rpx
}

.picker-cancel {
    color: #969799;
    font-size: 28rpx
}

.picker-title {
    color: #323233;
    font-size: 30rpx;
    font-weight: 500
}

.picker-placeholder {
    width: 72rpx
}

.picker-page {
    -webkit-flex: 1;
    flex: 1;
    max-height: 56vh
}

.picker-item {
    border-bottom: 1rpx solid #f7f8fa;
    color: #323233;
    font-size: 30rpx;
    padding: 28rpx 32rpx;
    text-align: center
}

.picker-item-active {
    color: #3882ff;
    font-weight: 500
}
