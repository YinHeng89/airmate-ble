.container {
    background-color: rgba(0,0,0,.4);
    height: 100%;
    left: 0;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 10000
}

.ota-view {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff;
    border-radius: 30rpx;
    bottom: 30rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 400rpx;
    -webkit-justify-content: space-around;
    justify-content: space-around;
    left: 30rpx;
    margin-bottom: 12vh;
    padding-top: 20rpx;
    position: fixed;
    right: 30rpx
}

.view_0 {
    font-size: 34rpx;
    height: 48rpx;
    line-height: 48rpx;
    width: 400rpx
}

.view_0,.view_1 {
    color: #242424;
    font-family: PingFangSC-Regular,PingFang SC;
    font-weight: 400;
    text-align: center
}

.view_1 {
    font-size: 32rpx;
    height: 44rpx;
    line-height: 44rpx;
    width: 300rpx
}

.view_2 {
    font-size: 30rpx;
    margin-top: -30rpx;
    width: 300rpx
}

.view_2,.view_3 {
    color: #919191;
    font-family: PingFangSC-Regular,PingFang SC;
    font-weight: 400;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center
}

.view_3 {
    font-size: 28rpx;
    padding-bottom: 30rpx;
    width: 600rpx
}

.danger {
    color: #ee0a24
}

.ota-pg {
    height: 6rpx;
    width: 86%
}

.image_0 {
    height: 104rpx;
    width: 104rpx
}

.view-ok {
    border-top: 2rpx solid #f7f7f7;
    color: #398bff;
    -webkit-flex-direction: column;
    flex-direction: column;
    font-family: PingFangSC-Regular,PingFang SC;
    font-size: 32rpx;
    font-weight: 400;
    height: 90rpx;
    line-height: 44rpx;
    margin-bottom: 0;
    text-align: center;
    width: 100%
}

.box,.view-ok {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center
}

.box {
    height: 100rpx;
    margin: 0 auto;
    overflow: unset
}

.loading {
    position: relative
}

.loading>wx-view {
    background-color: #838383;
    border-radius: 10rpx;
    height: 18rpx;
    position: absolute;
    width: 6rpx
}

.loading>wx-view:nth-child(1) {
    -webkit-animation: loading 1s infinite;
    animation: loading 1s infinite;
    left: 0rpx;
    top: 24rpx
}

.loading>wx-view:nth-child(2) {
    -webkit-animation: loading 1s .125s infinite;
    animation: loading 1s .125s infinite;
    left: 18.5rpx;
    top: 18.5rpx;
    -webkit-transform: rotate(-45deg);
    transform: rotate(-45deg)
}

.loading>wx-view:nth-child(3) {
    -webkit-animation: loading 1s .25s infinite;
    animation: loading 1s .25s infinite;
    left: 24rpx;
    top: 0rpx;
    -webkit-transform: rotate(90deg);
    transform: rotate(90deg)
}

.loading>wx-view:nth-child(4) {
    -webkit-animation: loading 1s .375s infinite;
    animation: loading 1s .375s infinite;
    left: 18.5rpx;
    top: -18.5rpx;
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg)
}

.loading>wx-view:nth-child(5) {
    -webkit-animation: loading 1s .5s infinite;
    animation: loading 1s .5s infinite;
    left: 0rpx;
    top: -24rpx;
    -webkit-transform: rotate(0deg);
    transform: rotate(0deg)
}

.loading>wx-view:nth-child(6) {
    -webkit-animation: loading 1s .625s infinite;
    animation: loading 1s .625s infinite;
    left: -18.5rpx;
    top: -18.5rpx;
    -webkit-transform: rotate(-45deg);
    transform: rotate(-45deg)
}

.loading>wx-view:nth-child(7) {
    -webkit-animation: loading 1s .75s infinite;
    animation: loading 1s .75s infinite;
    left: -24rpx;
    top: 0rpx;
    -webkit-transform: rotate(90deg);
    transform: rotate(90deg)
}

.loading>wx-view:nth-child(8) {
    -webkit-animation: loading 1s .875s infinite;
    animation: loading 1s .875s infinite;
    left: -18.5rpx;
    top: 18.5rpx;
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg)
}

@-webkit-keyframes loading {
    50% {
        opacity: .1
    }

    100% {
        opacity: 1
    }
}

@keyframes loading {
    50% {
        opacity: .1
    }

    100% {
        opacity: 1
    }
}