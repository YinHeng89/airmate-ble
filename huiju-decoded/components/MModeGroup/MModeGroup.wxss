.mode-wrapper {
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    gap: 31rpx
}

.mode-item,.mode-wrapper {
    display: -webkit-flex;
    display: flex
}

.mode-item {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 9999px;
    box-sizing: border-box;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100rpx
}

.mode-btn {
    background-color: #f8f8f8!important
}

.mode-btn:active {
    background-color: #4186fa!important
}

.mode-btn .mode-text {
    color: #69696c!important
}

.mode-btn:active .mode-text {
    color: #fff!important
}

.mode-text {
    font-size: 24rpx;
    font-weight: 400;
    line-height: 34rpx;
    max-width: 72rpx;
    text-align: center
}

.active {
    background: #5086fe
}

.inactive {
    background: #eee
}

.active-text {
    color: #fff
}

.inactive-text {
    color: #69696c
}
