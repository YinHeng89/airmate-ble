.switch-item-wrapper {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border-radius: 20rpx;
    box-shadow: var(--box-shadow-sm);
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    height: 112rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding: 0 32rpx
}

.switch-label {
    color: #282c37;
    font-size: 32rpx
}

.mode-wrapper-1 {
    background-color: #fff;
    border-radius: 20rpx;
    box-shadow: var(--box-shadow-sm);
    box-sizing: border-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    gap: 31rpx;
    margin-top: 8px;
    padding: 4px;
    width: 100%
}

.hidden {
    display: none
}

.mode-item-1,.show {
    display: -webkit-flex;
    display: flex
}

.mode-item-1 {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 9999px;
    box-sizing: border-box;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100rpx
}

.mode-text-1 {
    font-size: 24rpx;
    font-weight: 400;
    line-height: 34rpx;
    max-width: 72rpx;
    text-align: center
}

.active {
    background: #5086fe
}

.inactive {
    background: #eee
}

.active-text {
    color: #fff
}

.inactive-text {
    color: #69696c
}
